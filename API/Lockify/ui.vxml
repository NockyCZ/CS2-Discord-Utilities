<!-- Custom world panel layout for point_clientui_world_panel -->
<root>
    <styles>
        <include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
        <include src="s2r://panorama/styles/in_world_hideout_panel.vcss_c" />
    </styles>

    <Panel class="WindowRoot" hittest="false">
        <Panel id="UnitStatus" hittest="false">
            <Panel id="Play" class="hideoutLabel primaryLabel">
                <Panel class="background" />
                <Label class="name playLabel" text="LOCKIFY PLAY" />
            </Panel>

            <Panel id="TeleportToSandbox" class="hideoutLabel tertiaryLabel">
                <Label class="name tpLabel" text="LOCKIFY SANDBOX" />
            </Panel>

            <Panel id="TeleportToHideout" class="hideoutLabel tertiaryLabel">
                <Label class="name hideoutLabel" text="LOCKIFY HIDEOUT" />
            </Panel>
        </Panel>
    </Panel>
</root>
